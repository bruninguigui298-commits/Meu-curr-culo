# Copie para .env e preencha. Nunca faça commit do .env.
NODE_ENV=development
PORT=3000
# Postgres (Neon, Aiven, Render...). Em dev:demo não precisa.
DATABASE_URL=postgres://usuario:senha@localhost:5432/curriculo
# Senha do /admin (mínimo 12 caracteres em produção).
ADMIN_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie da sessão do admin (mínimo 32 caracteres em produção).
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio-aqui
# Status dos projetos
STATUS_TIMEOUT_MS=8000
STATUS_CACHE_SECONDS=300
